{
  "name": "falai",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "bun run build.ts",
    "dev": "bun run build.ts --watch",
    "typecheck": "bun check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "simple-git-hooks",
    "render": "bun run build && bun run scripts/render-assets.ts"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/chrome": "^0.3.5",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "simple-git-hooks": "^2.14.0"
  },
  "peerDependencies": {
    "typescript": "^7"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.1"
  },
  "simple-git-hooks": {
    "pre-commit": "bunx lint-staged"
  },
  "lint-staged": {
    "*": "prettier --write --ignore-unknown"
  }
}
